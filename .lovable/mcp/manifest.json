{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://oskwtnluunvdlbjptday.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "altus-app",
      "version": "0.1.0",
      "title": "ALTUS App"
    },
    "tools": [
      {
        "name": "get_overview",
        "title": "Visão geral do ALTUS",
        "description": "Resumo do painel: saldo financeiro do mês, peso mais recente, estudos, livros, metas e rotina diária.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Listar transações",
        "description": "Lista as transações financeiras do usuário, das mais recentes para as mais antigas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "entrada",
                    "saida",
                    "todas"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrar por tipo. Use 'todas' ou null para tudo."
            },
            "month": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mês no formato AAAA-MM, ou null para todos."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Quantidade máxima (padrão 50)."
            }
          },
          "required": [
            "type",
            "month",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_transaction",
        "title": "Registrar transação",
        "description": "Registra uma entrada ou saída financeira no ALTUS.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "entrada",
                "saida"
              ],
              "description": "Tipo do lançamento."
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor em reais."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Descrição curta."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Categoria, ex.: Alimentação, Salário."
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data AAAA-MM-DD, ou null para hoje."
            }
          },
          "required": [
            "type",
            "value",
            "description",
            "category",
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_weight",
        "title": "Registrar peso",
        "description": "Adiciona um registro de peso corporal (kg) no módulo Corpo & Saúde.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500,
              "description": "Peso em quilos."
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data AAAA-MM-DD, ou null para hoje."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Observação opcional."
            }
          },
          "required": [
            "weight",
            "date",
            "notes"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_study",
        "title": "Registrar estudo",
        "description": "Registra uma sessão de estudo (tópico, área, duração e aprendizados).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "description": "Tópico estudado."
            },
            "area": {
              "type": "string",
              "minLength": 1,
              "description": "Área de conhecimento."
            },
            "duration": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 1440,
              "description": "Duração em minutos."
            },
            "type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tipo de estudo (curso, leitura...), ou null."
            },
            "learned": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "O que foi aprendido, ou null."
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data AAAA-MM-DD, ou null para hoje."
            }
          },
          "required": [
            "topic",
            "area",
            "duration",
            "type",
            "learned",
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_goals",
        "title": "Listar metas e rotina",
        "description": "Lista as metas macro (com progresso) e as ações da rotina diária do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "log_kaizen",
        "title": "Registrar Kaizen do dia",
        "description": "Grava a reflexão diária Kaizen: o que melhorou hoje e o que melhorar amanhã.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "improvedToday": {
              "type": "string",
              "minLength": 1,
              "description": "O que foi melhorado hoje."
            },
            "improveTomorrow": {
              "type": "string",
              "minLength": 1,
              "description": "O que melhorar amanhã."
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Notas adicionais, ou null."
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data AAAA-MM-DD, ou null para hoje."
            }
          },
          "required": [
            "improvedToday",
            "improveTomorrow",
            "notes",
            "date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
